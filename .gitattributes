# Pin line endings so editors/tools on Windows can't reintroduce CRLF churn
# (the source + generated bundle must stay LF for reproducible build-hash sync).
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
